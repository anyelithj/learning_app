# ===== Server =====
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# ===== Database (PostgreSQL) =====
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=proydemo
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=false

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=60

# ===== JWT =====
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_REFRESH_EXPIRES_IN=7d

# ===== Bcrypt =====
BCRYPT_SALT_ROUNDS=12

# ===== OAuth (id_token verification — mismo CLIENT_ID que el frontend) =====
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=common

# ===== Password reset =====
# URL pública del frontend usada para construir el link de reset enviado por email
FRONTEND_URL=http://localhost:7000

# ===== CORS =====
CORS_ORIGINS=http://localhost:7000,http://127.0.0.1:7000

# ===== Throttler =====
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ===== FastAPI (AI Service) =====
AI_SERVICE_URL=http://localhost:8000
